{
  "name": "code-review-agent",
  "version": "1.0.0",
  "description": "Multi-agent AI code review system built with Mastra",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "mastra dev",
    "ui": "tsx src/server.ts",
    "build": "tsc",
    "review": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test:correctness": "tsx src/test-correctness.ts",
    "test:supervisor": "tsx src/test-supervisor.ts"
  },
  "keywords": [
    "ai",
    "code-review",
    "mastra",
    "multi-agent"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mastra/core": "^1.69.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
